#--------------------------------------------------------------------
# MARKETING (MI) - Example environment configuration
# Copy this file to ".env" and fill in real values. Never commit ".env".
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = ''
app.appName = 'MARKETING (MI)'

#--------------------------------------------------------------------
# AUTHENTICATION - Bootstrap administrator
#--------------------------------------------------------------------
# Required only when running UserSeeder.
# Never commit the real value.
auth.seedAdminPassword = YOUR_BOOTSTRAP_ADMIN_PASSWORD

# Active Directory account (sAMAccountName) made ADMIN by AppAdminUserSeeder.
auth.bootstrapAdmin = admin

#--------------------------------------------------------------------
# ACTIVE DIRECTORY (password check by ldap_bind)
#--------------------------------------------------------------------
# Check on the server with `php spark ldap:diagnose`.
ldap.host   =
ldap.port   = 389
ldap.baseDn =
ldap.domain =
ldap.useTls = false

#--------------------------------------------------------------------
# DATABASE - Local application database (MySQL/MariaDB)
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# DATABASE - Oracle source (business data, read-only extractions)
#--------------------------------------------------------------------

database.oracle.dsn =
database.oracle.username =
database.oracle.password =
database.oracle.charset = AL32UTF8

#--------------------------------------------------------------------
# EXTRACTION LIMITS
#--------------------------------------------------------------------

extraction.maxDisplayRows = 10000
extraction.maxExportRows = 100000
extraction.queryTimeoutSeconds = 300
extraction.fetchBatchSize = 1000
extraction.exportPrefetchRows = 5000
extraction.exportTimeLimitSeconds = 1800
extraction.xlsxMaxRowsPerSheet = 1048575
extraction.dashboardCacheTtl = 600
extraction.filterOptionsCacheTtl = 3600
extraction.exportSyncMaxRows = 150000
extraction.tableMaxOffset = 500000

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.expiration = 7200

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# 4 = errors and above (minimum: the export worker's failure reports are
# logged at 'error'); 7 = also info (job start / end lines).
logger.threshold = 4

#--------------------------------------------------------------------
# EXPORT SOURCE
#--------------------------------------------------------------------
# snapshot (default, local validated file) | oracle (live, rollback only)
# snapshot.exportSource = snapshot

#--------------------------------------------------------------------
# EXPORT FILES
#--------------------------------------------------------------------
# OpenSpout (XLSX) scratch folder — default: writable/tmp/openspout_tmp of
# this checkout. Prepared on Linux by docs/deploy/prepare-writable.sh (systemd);
# if moved elsewhere, add it there too. See docs/deploy/export-worker.md.
# export.openSpoutTempPath = /var/www/extractor/writable/tmp/openspout_tmp
